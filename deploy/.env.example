# ----- chain -----
DEX_CHAIN_ID=9001
DEX_EVM_RPC=http://host.docker.internal:8545
DEX_EVM_WS=ws://host.docker.internal:8546

# ----- contract addresses (extracted from contracts/dex-deployment.json) -----
DEX_FACTORY=0x76ee26161F681e79DECb982bB8CC1fF8deC278E0
DEX_ROUTER=0x3d7Ac9A6eFc3447afE04E4c6A9C14b60cf5C7240
DEX_WECY=0x8510057181a49Cc685aC5a01abEa33CC07873F4F
DEX_MULTICALL=0xd4CBB1cBC59DB9FD22f2806F439B0d80bE07BC77

# ----- postgres (isolated from explorer) -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=energy_dex
POSTGRES_USER=dex
POSTGRES_PASSWORD=dex
DEX_PG_DSN=postgres://dex:dex@postgres:5432/energy_dex?sslmode=disable

# ----- redis -----
DEX_REDIS_ADDR=redis:6379
DEX_REDIS_DB=0

# ----- indexer -----
DEX_INDEXER_START_HEIGHT=0          # 0 = pair factory deploy height (auto-discover)
DEX_INDEXER_BATCH_SIZE=200          # blocks per backfill iteration
DEX_INDEXER_CONFIRMATIONS=2
DEX_INDEXER_TICK_INTERVAL=2s

# Comma-separated list of token addresses to mark as trust_score=2 (verified).
# WECY + DEX_USDT are auto-promoted; add any additional curated assets here.
DEX_VERIFIED_TOKENS=

# Optional CDN prefix for token logos. The indexer assembles
# `${DEX_LOGO_BASE_URL}/<lowercase-address>.png` and stores it in tokens.logo_uri.
# Leave blank to fall back to deterministic gradient placeholders.
DEX_LOGO_BASE_URL=

# ----- api -----
DEX_API_LISTEN=:8081
DEX_API_CORS_ORIGINS=*
DEX_API_RATE_PUBLIC=60
DEX_API_RATE_PARTNER=600

# ----- observability -----
DEX_PROM_LISTEN=:9100
LOG_LEVEL=info

# ----- web -----
NEXT_PUBLIC_DEX_API_BASE=http://localhost:8081
NEXT_PUBLIC_DEX_WS=ws://localhost:8081/ws
NEXT_PUBLIC_DEX_CHAIN_ID=9001
NEXT_PUBLIC_DEX_RPC=http://localhost:8545
NEXT_PUBLIC_EXPLORER_BASE=http://localhost:3000
NEXT_PUBLIC_WC_PROJECT_ID=                # WalletConnect Cloud project id
NEXT_PUBLIC_DEX_FACTORY=0x76ee26161F681e79DECb982bB8CC1fF8deC278E0
NEXT_PUBLIC_DEX_ROUTER=0x3d7Ac9A6eFc3447afE04E4c6A9C14b60cf5C7240
NEXT_PUBLIC_DEX_WECY=0x8510057181a49Cc685aC5a01abEa33CC07873F4F
