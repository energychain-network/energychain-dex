{
  "uid": "dex-overview",
  "title": "EnergySwap · Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "tags": ["dex", "energychain"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Indexer head lag (sec)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "time() - dex_indexer_last_block_time_seconds",
          "legendFormat": "lag",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red",    "value": 120 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tracked pairs",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "dex_indexer_pairs", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Swaps / sec (5m)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(dex_indexer_swaps_total[5m])",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "API request rate (1m)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(dex_api_requests_total[1m]))",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Block-time lag (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "time() - dex_indexer_last_block_time_seconds",
          "legendFormat": "lag",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Indexer height vs chain head",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "dex_indexer_chain_head", "legendFormat": "chain head", "refId": "A" },
        { "expr": "dex_indexer_processed_height", "legendFormat": "processed", "refId": "B" }
      ]
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Swaps & liquidity events / min",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "rate(dex_indexer_swaps_total[1m])*60", "legendFormat": "swaps/min", "refId": "A" },
        { "expr": "rate(dex_indexer_liquidity_events_total[1m])*60", "legendFormat": "lp events/min", "refId": "B" }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Tick duration p50 / p99 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(dex_indexer_tick_seconds_bucket[5m]))",  "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.99, rate(dex_indexer_tick_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 30,
      "type": "timeseries",
      "title": "API latency p50 / p95 / p99 by route (s)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (route, le) (rate(dex_api_request_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{route}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (route, le) (rate(dex_api_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{route}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (route, le) (rate(dex_api_request_duration_seconds_bucket[5m])))", "legendFormat": "p99 {{route}}", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 40,
      "type": "timeseries",
      "title": "Cache hit ratio (Redis)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(dex_api_cache_lookups_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(dex_api_cache_lookups_total[5m])), 1)",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Reorg unwind depth",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "dex_indexer_reorg_depth", "legendFormat": "depth", "refId": "A" }
      ]
    }
  ]
}
